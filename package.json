{
  "name": "history-journeys",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "vitest run tests/content",
    "test": "vitest run tests/unit tests/stage tests/fonts tests/tools/bake-ground.test.ts tests/tools/make-fonts.test.ts tests/tools/route-tools.test.ts",
    "test:e2e": "playwright test",
    "check:size": "vitest run tests/build --silent=false",
    "check": "npm run typecheck && npm run validate && npm run test && npm run build && npm run check:size",
    "bake": "vitest run tests/tools/bake-ground.test.ts --mode bake --reporter=verbose",
    "fonts": "vitest run tests/tools/make-fonts.test.ts --mode fonts --reporter=verbose",
    "route:terrain": "vitest run tests/tools/route-tools.test.ts --mode terrain --reporter=verbose",
    "route:today": "vitest run tests/tools/route-tools.test.ts --mode today --reporter=verbose",
    "route:map": "vitest run tests/tools/route-tools.test.ts --mode map --reporter=verbose",
    "route:bank": "vitest run tests/tools/route-tools.test.ts --mode bank --reporter=verbose",
    "stills": "playwright test -c playwright.stills.config.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "subset-font": "2.9.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
